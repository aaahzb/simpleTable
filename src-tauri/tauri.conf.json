{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simpleTable",
  "version": "0.1.0",
  "identifier": "com.simpletable.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "simpleTable",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "CSV document",
        "role": "Editor",
        "contentTypes": ["public.comma-separated-values-text"],
        "mimeType": "text/csv"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Plain text document",
        "role": "Editor",
        "contentTypes": ["public.plain-text"],
        "mimeType": "text/plain"
      },
      {
        "ext": ["log"],
        "name": "Log Document",
        "description": "Log document",
        "role": "Editor",
        "contentTypes": ["public.plain-text"],
        "mimeType": "text/plain"
      }
    ]
  }
}
